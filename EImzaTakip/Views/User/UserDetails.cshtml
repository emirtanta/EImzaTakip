@model GetUserDto

@{
    ViewData["Title"] = "Kullanıcı Detayı";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">

        <h1 class="h3 mb-0 text-gray-800">
            Kullanıcı Detayı
        </h1>

    </div>

    <div class="row">

        <div class="col-lg-8">

            <div class="card shadow mb-4">

                <div class="card-header py-3">

                    <h6 class="m-0 font-weight-bold text-primary">
                        Kullanıcı Bilgileri
                    </h6>

                </div>

                <div class="card-body">

                    <!-- ID -->
                    <div class="form-group mb-4">

                        <label class="font-weight-bold text-dark">
                            Id
                        </label>

                        <input value="@Model.Id"
                               class="form-control form-control-lg"
                               readonly />

                    </div>

                    <!-- NAME -->
                    <div class="form-group mb-4">

                        <label asp-for="Name"
                               class="font-weight-bold text-dark">
                        </label>

                        <input asp-for="Name"
                               class="form-control form-control-lg"
                               readonly />

                    </div>

                    <!-- SURNAME -->
                    <div class="form-group mb-4">

                        <label asp-for="Surname"
                               class="font-weight-bold text-dark">
                        </label>

                        <input asp-for="Surname"
                               class="form-control form-control-lg"
                               readonly />

                    </div>

                    <!-- NICKNAME -->
                    <div class="form-group mb-4">

                        <label asp-for="NickName"
                               class="font-weight-bold text-dark">
                        </label>

                        <input asp-for="NickName"
                               class="form-control form-control-lg"
                               readonly />

                    </div>

                    <!-- EMAIL -->
                    <div class="form-group mb-4">

                        <label asp-for="Email"
                               class="font-weight-bold text-dark">
                        </label>

                        <input asp-for="Email"
                               class="form-control form-control-lg"
                               readonly />

                    </div>

                    <!-- ROLE -->
                    <div class="form-group mb-4">

                        <label asp-for="RoleName"
                               class="font-weight-bold text-dark">
                        </label>

                        <input asp-for="RoleName"
                               class="form-control form-control-lg"
                               readonly />

                    </div>

                    <!-- STATUS -->
                    <div class="form-group mb-4">

                        <label asp-for="Status"
                               class="font-weight-bold text-dark d-block">
                        </label>

                        @if (Model.Status)
                        {
                            <span class="badge bg-success text-white p-2">
                                Aktif
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger text-white p-2">
                                Pasif
                            </span>
                        }

                    </div>

                    <div class="d-flex justify-content-end">

                        <a asp-controller="User"
                           asp-action="UserList"
                           class="btn btn-secondary mr-2">

                            <i class="fas fa-arrow-left mr-1"></i>
                            Geri Dön

                        </a>

                        <a asp-controller="User"
                           asp-action="UserUpdate"
                           asp-route-id="@Model.Id"
                           class="btn btn-warning">

                            <i class="fas fa-edit mr-1"></i>
                            Güncelle

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>