@model List<Department>
@{
    ViewData["Title"] = "Birimler";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Css {

    <link href="~/tema/vendor/datatables/dataTables.bootstrap4.min.css"
          rel="stylesheet" />
}

<div class="container-fluid">

    <!-- ALERT -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show autoHideAlert">

            @TempData["Success"]

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show autoHideAlert">

            @TempData["Error"]

        </div>
    }

    <!-- PAGE HEADER -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">

        <h1 class="h3 mb-0 text-gray-800">
            Birim Listesi
        </h1>

        <a asp-controller="Department"
           asp-action="DepartmentCreate"
           class="btn btn-primary">

            <i class="fas fa-plus"></i>
            Yeni Birim

        </a>

    </div>

    <!-- TABLE -->
    <div class="card shadow mb-4">

        <div class="card-header py-3">

            <h6 class="m-0 font-weight-bold text-primary">
                Birimler
            </h6>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered"
                       id="dataTable"
                       width="100%"
                       cellspacing="0">

                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Birim Adı</th>
                            <th>Durum</th>
                            <th>Detay</th>
                            <th>Güncelle</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.Id</td>

                                <td>@item.Name</td>

                                <td>

                                    @if (item.Status)
                                    {
                                        <span class="badge bg-success text-white p-2">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-white p-2">
                                            Pasif
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-controller="Department"
                                       asp-action="DepartmentDetails"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm">

                                        Detay

                                    </a>

                                </td>

                                <td>

                                    <a asp-controller="Department"
                                       asp-action="DepartmentUpdate"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">

                                        Güncelle

                                    </a>

                                </td>

                                <td>

                                    <button type="button"
                                            class="btn btn-sm @(item.Status ? "btn-danger" : "btn-success") changeStatusBtn"
                                            data-id="@item.Id"
                                            data-name="@item.Name"
                                            data-status="@(item.Status ? "Pasif" : "Aktif")">

                                        @(item.Status ? "Pasif Yap" : "Aktif Yap")

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<!-- STATUS MODAL -->
<div class="modal fade"
     id="statusModal"
     tabindex="-1"
     role="dialog">

    <div class="modal-dialog"
         role="document">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Durum Değiştir
                </h5>

                <button type="button"
                        class="close"
                        data-dismiss="modal">

                    <span>&times;</span>

                </button>

            </div>

            <div class="modal-body">

                <p id="statusMessage"></p>

            </div>

            <div class="modal-footer">

                <a id="confirmStatusBtn"
                   class="btn btn-primary">

                    Evet

                </a>

                <button type="button"
                        class="btn btn-secondary"
                        data-dismiss="modal">

                    Vazgeç

                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="~/tema/vendor/datatables/jquery.dataTables.min.js"></script>

    <script src="~/tema/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <script>

        $(document).ready(function () {

            // DATATABLE
            $('#dataTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/tr.json'
                }
            });

            // STATUS MODAL
            $('.changeStatusBtn').click(function () {

                var id = $(this).data('id');
                var departmentName = $(this).data('name');
                var status = $(this).data('status');

                $('#statusMessage').html(
                    '<b>' + departmentName +
                    '</b> birimini <b>' +
                    status +
                    '</b> yapmak istediğinize emin misiniz?'
                );

                $('#confirmStatusBtn').attr(
                    'href',
                    '/Department/ChangeStatus/' + id
                );

                $('#statusModal').modal('show');
            });

            // ALERT AUTO HIDE
            setTimeout(function () {

                $('.autoHideAlert').fadeOut('slow');

            }, 5000);

        });

    </script>
}

