@model List<Role>
@{
    ViewData["Title"] = "Roller";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Css{

    <!-- Custom styles for this page -->
    <link href="~/tema/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
}


<div class="container-fluid">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">
        Rol Listesi
    </h1>

    <p class="mb-4">
        Sistem içerisinde bulunan roller aşağıda listelenmektedir.
    </p>

    <a asp-controller="Role" asp-action="RoleCreate"
       class="btn btn-primary mb-3">
        Yeni Rol
    </a>

    <!-- DataTable -->
    <div class="card shadow mb-4">

        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                Rol Tablosu
            </h6>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered"
                       id="dataTable"
                       width="100%"
                       cellspacing="0">

                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Rol Adı</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.Id</td>

                                <td>@item.Name</td>

                                <td>
                                    @if (item.Status)
                                    {
                                        <span class="badge bg-success text-white">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-white">
                                            Pasif
                                        </span>
                                    }
                                </td>

                                <td>

                                    <a asp-controller="Role"
                                       asp-action="RoleUpdate"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm">
                                        Güncelle
                                    </a>

                                    @if (item.Status)
                                    {
                                        <button type="button"
                                                class="btn btn-danger btn-sm changeStatusBtn"
                                                data-id="@item.Id"
                                                data-name="@item.Name"
                                                data-status="Pasif">
                                            Pasif Yap
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-success btn-sm changeStatusBtn"
                                                data-id="@item.Id"
                                                data-name="@item.Name"
                                                data-status="Aktif">
                                            Aktif Yap
                                        </button>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- Status Modal -->
    <div class="modal fade"
         id="statusModal"
         tabindex="-1"
         role="dialog"
         aria-hidden="true">

        <div class="modal-dialog"
             role="document">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Durum Değiştirme
                    </h5>

                    <button type="button"
                            class="close"
                            data-dismiss="modal">

                        <span>&times;</span>

                    </button>

                </div>

                <div class="modal-body">

                    <p id="statusMessage"></p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal">
                        Vazgeç
                    </button>

                    <a id="confirmStatusBtn"
                       href="#"
                       class="btn btn-primary">
                        Evet
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <!-- Page level plugins -->
    <script src="~/tema/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/tema/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <script>

        $(document).ready(function () {

            // DATATABLE
            $('#dataTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/tr.json'
                }
            });

            // STATUS MODAL
            $('.changeStatusBtn').click(function () {

                var id = $(this).data('id');
                var roleName = $(this).data('name');
                var status = $(this).data('status');

                $('#statusMessage').html(
                    '<b>' + roleName + '</b> rolünü <b>' +
                    status +
                    '</b> yapmak istediğinize emin misiniz?'
                );

                $('#confirmStatusBtn').attr(
                    'href',
                    '/Role/ChangeStatus/' + id
                );

                $('#statusModal').modal('show');
            });

        });

    </script>
}

